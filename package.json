{
	"name": "tiny-mixin",
	"version": "1.1.2",
	"description": "A lightweight TypeScript-first class mixin utility",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"check": "bunx --bun @biomejs/biome check --write"
	},
	"keywords": [
		"class",
		"mixin",
		"typescript",
		"javascript",
		"utility",
		"composition"
	],
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/louiszn/tiny-mixin"
	},
	"bugs": {
		"url": "https://github.com/louiszn/tiny-mixin/issues"
	},
	"homepage": "https://github.com/louiszn/tiny-mixin#readme",
	"author": "Louiszn",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@changesets/cli": "^2.29.8",
		"@types/bun": "latest",
		"@types/node": "^25.2.3",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3"
	}
}