{
	"name": "tiny-mixin",
	"version": "1.1.4",
	"description": "A lightweight TypeScript-first class mixin utility",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"check": "bunx --bun @biomejs/biome check --write"
	},
	"keywords": [
		"class",
		"mixin",
		"typescript",
		"javascript",
		"utility",
		"composition"
	],
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/louiszn/tiny-mixin.git"
	},
	"bugs": {
		"url": "https://codeberg.org/louiszn/tiny-mixin/issues"
	},
	"homepage": "https://codeberg.org/louiszn/tiny-mixin#readme",
	"author": "Louiszn",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@changesets/cli": "^2.29.8",
		"@types/bun": "latest",
		"@types/node": "^25.2.3",
		"publint": "^0.3.22",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=18"
	}
}
